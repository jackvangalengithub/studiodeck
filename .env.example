APP_ENV=local
APP_URL=http://localhost:8080
# Empty means any verified email can create its own isolated studio.
DESIGNER_EMAILS=
# Optional absolute path. Default: storage/studiodeck.sqlite
DATABASE_PATH=
# log: local sign-in links in storage/mail.log; no email is sent.
# mail: PHP mail() via your server's configured mail transport.
# Local Docker Compose overrides this to mail and captures everything in MailCatcher.
MAIL_TRANSPORT=log
MAIL_FROM=studio@example.com
# Local Docker Compose inbox at http://localhost:1081 (SMTP stays inside Docker).
MAILCATCHER_PORT=1081
# Optional. Without AI, rules classify files and a factual budget helper works.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Parallel page-analysis requests per worker (1–8). Use 1 for a sequential baseline.
DOCUMENT_PAGE_CONCURRENCY=4
OPENAI_IMAGE_MODEL=gpt-image-1
# Docker Compose only: host port for the web container. Keep APP_URL on the same port.
HOST_PORT=8080

# Google Drive import (Google Cloud OAuth client of type Web application).
# Enable the Drive API and register APP_URL/api.php?action=drive_callback as redirect URI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Generate once with: php -r 'echo base64_encode(random_bytes(32)),PHP_EOL;'
# Keep this key private and stable; it encrypts the stored OAuth tokens.
GOOGLE_DRIVE_TOKEN_KEY=

# Stripe: run php scripts/setup-stripe.php with a test key, then copy its IDs here.
STRIPE_SECRET_KEY=
STRIPE_API_URL=https://api.stripe.com/v1
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_PASS=
STRIPE_PRICE_EXTENSION=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_EXTRA_PROJECT=
STRIPE_PRICE_EXTRA_SEAT=
# Enable after Stripe Tax has been configured for your business.
STRIPE_AUTOMATIC_TAX=false
# Expiry is always enforced. Enable cleanup only after retention notices/exports are verified.
BILLING_RETENTION_DELETE=false

# Historical Website price ID for reconciling existing add-on subscriptions only.
# New subscriptions include Website without a separate price.
STRIPE_PRICE_WEBSITE=
# Keep outside public/. Must be shared by web and billing worker.
WEBSITE_STORAGE_PATH=
# Local-only development entitlement; ignored outside APP_ENV=local.
WEBSITE_LOCAL_FREE=false
# Hostname of your configured custom-domain HTTPS gateway.
WEBSITE_CNAME_TARGET=

# Optional AI camera movement (paid Google Veo requests; generated only on explicit request).
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
VEO_PROJECT_LIMIT=10

# Comma-separated account emails allowed to review product feedback across studios.
# Studio admin permissions alone do not grant access. Empty disables inbox access.
PRODUCT_FEEDBACK_TEAM_EMAILS=
# Mailbox notified of each new product feedback report. Independent of inbox access.
# Uses the existing worker and MAIL_TRANSPORT; empty disables notifications.
PRODUCT_FEEDBACK_NOTIFY_EMAIL=
# Release label attached to product feedback reports.
APP_VERSION=unversioned
